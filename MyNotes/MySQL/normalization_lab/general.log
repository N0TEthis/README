2026-11-12T08:24:36.446255Z	   21 Query	SELECT
    o.order_id AS 'Код заказа',
    o.order_date AS 'Дата',
    c.client_id AS 'Код клиента',
    c.client_name AS 'Имя клиента',
    p.product_id AS 'Код товара',
    p.product_name AS 'Название товара',
    p.price AS 'Цена',
    pc.category_id AS 'Код товарной классификации',
    pc.category_name AS 'Имя товарной классификации',
    oi.quantity AS 'Количество'
FROM orders o
JOIN clients c
    ON o.client_id = c.client_id
JOIN order_items oi
    ON o.order_id = oi.order_id
JOIN products p
    ON oi.product_id = p.product_id
JOIN product_categories pc
    ON p.category_id = pc.category_id
ORDER BY o.order_id, p.product_id
2026-11-12T08:25:28.085110Z	   21 Query	SELECT
    order_id,
    COUNT(DISTINCT client_id) AS clients_count
FROM orders
GROUP BY order_id
2026-11-12T08:25:56.038296Z	   21 Query	SELECT
    product_id,
    product_name,
    category_id,
    COUNT(*) AS category_count
FROM products
GROUP BY product_id, product_name, category_id
